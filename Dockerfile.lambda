# Multi-stage Dockerfile for Audit Lambda Container Image
# Provides deterministic execution environment with pre-cached NLP models

FROM public.ecr.aws/lambda/python:3.11 AS base

# Install system dependencies if required
RUN yum install -y gcc gcc-c++ && yum clean all

WORKDIR ${LAMBDA_TASK_ROOT}

# Install CPU-optimized PyTorch first to prevent huge CUDA bloat
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.2.0+cpu

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download spaCy English model into the container layer
RUN python -m spacy download en_core_web_sm

# Copy application source code and configurations
COPY config/ ${LAMBDA_TASK_ROOT}/config/
COPY schemas/ ${LAMBDA_TASK_ROOT}/schemas/
COPY auditor/ ${LAMBDA_TASK_ROOT}/auditor/
COPY lambda/ ${LAMBDA_TASK_ROOT}/lambda/

# Environment variables for offline inference and deterministic caching
ENV TRANSFORMERS_CACHE=/opt/ml/models \
    HF_HOME=/opt/ml/models \
    PYTHONPATH=${LAMBDA_TASK_ROOT}

# Set the CMD to the Audit Lambda handler
CMD [ "lambda.audit_handler.handler" ]
