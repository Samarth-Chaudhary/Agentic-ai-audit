# AI Agent Governance & Audit Trail Analyzer
# Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS

# LLM Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here

# AWS Configuration
AWS_REGION=us-east-1
TRACE_BUCKET=ai-agent-audit-traces-prototype
RESULT_BUCKET=ai-agent-audit-results-prototype
DYNAMODB_TABLE=ai_agent_audit_results
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ai-agent-trace-ingestion-queue
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:ai-agent-governance-alerts

# Analytics Configuration (Athena / Glue)
ATHENA_DATABASE=agent_governance_db
ATHENA_OUTPUT_LOCATION=s3://ai-agent-audit-results-prototype/athena-query-results/

# NLP / Auditing Model Stack
EMBEDDING_MODEL=all-MiniLM-L6-v2
NLI_MODEL=roberta-large-mnli
